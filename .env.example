# Chat endpoint you were given. Nothing is built in.
HNL_CHAT_URL=
HNL_CHAT_KEY=

# Search is bring-your-own. This app does not include web search, page extract, or docs search.
# Optional tools endpoint if you connect a remote computer yourself.
HNL_TOOLS_URL=
HNL_TOOLS_KEY=

# Model name your own server expects. Nothing is built in.
HNL_MODEL=

# Optional split. The fast model works the harness. The thinking model plans and hashes what it saw.
# Laya picks the path between them. Leave blank to keep a single chat model.
HNL_FAST_URL=
HNL_FAST_MODEL=
HNL_THINK_URL=
HNL_THINK_MODEL=

# Optional image backend. Leave blank unless you run ComfyUI.
HNL_COMFY_URL=
HNL_COMFY_FALLBACK=
HNL_COMFY_MODEL=flux-2-klein-4b.safetensors
HNL_LAB_TOKEN=

# Operator door. Put real values in ~/.novapup/tentacle.env, not in this folder.
# TENTACLE_HOUSE_URL=
# TENTACLE_PORT=
# TENTACLE_PUBLIC_HOST=
# TENTACLE_ACCESS_REQUIRED=1
# TENTACLE_ACCESS_TEAM=
# TENTACLE_ACCESS_AUD=
# TENTACLE_TEAM_ID=
# TENTACLE_STUDIO_SSH=
